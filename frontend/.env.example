# ─── Required ───────────────────────────────────────────────
# Backend API base URL on Render (must end with /api)
VITE_API_URL=https://crosslink-api.onrender.com/api

# ─── Optional ───────────────────────────────────────────────
# WebSocket URL (defaults to API origin if omitted)
VITE_SOCKET_URL=https://crosslink-api.onrender.com

# SDG endpoint override (rarely needed)
VITE_SDG_API_PATH=/api/sdg
